# ============================================
# APPLICATION
# ============================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=

APP_SHARE_DIR=/share
DEFAULT_URI=http://localhost:8080


# ============================================
# NGINX
# ============================================

NGINX_PORT=8080


# ============================================
# POSTGRES
# ============================================

POSTGRES_USER=symfony
POSTGRES_PASSWORD=
POSTGRES_DB=symfony_dev
POSTGRES_PORT=5432

DB_SERVER_VERSION=17
DB_CHARSET=utf8
DB_COLLATION=en_US.utf8


# ============================================
# DATABASE SCHEMAS
# ============================================

AUTH_DB_SCHEMA=auth
VERIFICATION_DB_SCHEMA=verification
EMAIL_DB_SCHEMA=email
DICTIONARIES_DB_SCHEMA=dictionaries


# ============================================
# REDIS
# ============================================

REDIS_URL=redis://redis:6379


# ============================================
# MAIL
# ============================================

MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME=Место
MAILER_DSN=smtp://mailpit:1025


# ============================================
# KAFKA
# ============================================

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=

KAFKA_GROUP_ID=event-worker-group

KAFKA_TOPIC_VERIFICATION_EVENT=verification_events
KAFKA_TOPIC_AUTH_EVENT=auth_event
KAFKA_TOPIC_BITRIX_EVENT=bitrix_event


# ============================================
# LOCAL KAFKA CONTAINER
# ============================================

KAFKA_NODE_ID=1

KAFKA_PROCESS_ROLES=broker,controller

KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093

KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT

KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093

KAFKA_CLUSTER_ID=kraft-cluster-1

KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

KAFKA_AUTO_CREATE_TOPICS_ENABLE=true


# ============================================
# JAVA SERVICES
# ============================================

SERVER_PORT_JAVA=8080


# ============================================
# INTERNAL SERVICE URLS
# ============================================

EMAIL_SERVICE_URL=http://nginx
AUTH_SERVICE_URL=http://nginx
DICTIONARY_SERVICE_URL=http://nginx


BITRIX_SERVICE_URL=http://nginx

KAFKA_GATEWAY_URL=http://nginx/event/

DICTIONARY_CACHE_TTL=30

DICTIONARY_CACHE_VERSION=v2

TZ=UTC


# ============================================
# Версионирвоание микросервисов
# ============================================
EMAIL_APP_NAME=email-service
EMAIL_APP_VERSION=3.0.0


# ============================================
# INTERNAL CREDENTIALS
# ============================================

# Generate a random internal credential; never expose to browser code.
WEB_SERVICE_INTERNAL_TOKEN=

# Private verification-to-auth credential; generate at least 32 random characters.
REGISTRATION_INTERNAL_TOKEN=


# GigaChat: credentials stay in the ignored local .env
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# Defaults required by the Compose services. Credentials above must be generated locally.
CATALOG_DB_SCHEMA=catalog
POSTGRES_DATA_VOLUME=../storage/postgresql

# Paths are relative to the first Compose file directory (ONMI_infra/compose).
JWT_PRIVATE_KEY_PATH=../config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=../config/jwt/public.pem
JWT_CONTAINER_DIR=/var/jwt
JWT_AUDIENCE_ACCESS_TOKEN=microservices
JWT_CATALOG_ISSUER=auth-service

AUTH_ACCESS_TOKEN_TTL=300
AUTH_REFRESH_TOKEN_TTL=60000
AUTH_APP_NAME=auth-service
AUTH_APP_VERSION=1.0.0
VERIFICATION_APP_NAME=verification-service
VERIFICATION_APP_VERSION=14.3
DICTIONARIES_APP_NAME=dictionaries-service
DICTIONARIES_APP_VERSION=1.0.0
CATALOG_APP_NAME=catalog-service
CATALOG_APP_VERSION=1.0.0
CATALOG_UPLOAD_DIR=/var/www/html/var/uploads
CATALOG_CACHE_TTL=3600
CATALOG_CACHE_VERSION=v1
CATALOG_IMPORT_BATCH_SIZE=500

# Chat: generate random values locally before starting
NODE_DB_PASSWORD=
CHAT_TOKEN_SECRET=
CHAT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
